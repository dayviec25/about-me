<!-- templates/blog/blog-list.tmpl -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Writing · David Chung</title>
  {{ template "head-assets" }}
</head>
<body class="bg-canvas text-ink font-body antialiased">

  <div class="mx-auto w-full max-w-5xl px-5 md:px-8">
    <div class="md:flex md:gap-14">

      <aside class="md:w-56 md:shrink-0 md:self-start md:sticky md:top-0">
        {{ template "navigation" }}
      </aside>

      <main class="min-w-0 flex-1 py-12 md:py-24">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Writing</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight">Notes & essays</h1>

        {{ if not . }}
          <p class="mt-8 text-muted">No posts yet — check back soon.</p>
        {{ end }}

        <div class="mt-10 space-y-4">
          {{ range . }}
          <a href="/blog/{{ .Slug }}" class="block rounded-xl border border-line bg-surface p-6 transition hover:border-accent/40 hover:shadow-sm">
            <div class="font-mono text-[11px] uppercase tracking-wider text-muted">{{ .Date }}{{ if .Author }} &middot; {{ .Author }}{{ end }}</div>
            <h2 class="mt-2 font-display text-xl font-semibold tracking-tight">{{ .Title }}</h2>
            {{ if .Description }}<p class="mt-2 leading-relaxed text-muted">{{ .Description }}</p>{{ end }}
          </a>
          {{ end }}
        </div>
      </main>

    </div>
  </div>

</body>
</html>
