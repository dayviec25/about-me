<!-- templates/blog/blog-list.tmpl -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog · David Chung</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-900 text-white font-sans">

  <div class="flex justify-center">

    <div class="hidden md:block md:w-64 border-gray-800 overflow-y-auto mt-10">
      {{ template "navigation" }}
    </div>

    <div class="w-full md:max-w-2xl mx-8 my-10 flex-1 overflow-y-auto space-y-6">
      <h1 class="text-3xl font-bold">Blog</h1>

      {{ if not . }}
        <p class="text-gray-400">No posts yet — check back soon.</p>
      {{ end }}

      {{ range . }}
      <a href="/blog/{{ .Slug }}" class="block bg-stone-950 border border-stone-700 rounded-lg p-6 hover:border-stone-500 transition ease-in duration-200">
        <h2 class="text-xl font-semibold">{{ .Title }}</h2>
        <p class="text-sm text-gray-400 mt-1">{{ .Date }}{{ if .Author }} · {{ .Author }}{{ end }}</p>
        {{ if .Description }}<p class="text-gray-300 mt-3">{{ .Description }}</p>{{ end }}
      </a>
      {{ end }}
    </div>

  </div>
</body>
</html>
