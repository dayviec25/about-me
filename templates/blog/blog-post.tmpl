<!-- templates/blog/blog-post.tmpl -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ .Title }} · David Chung</title>
  {{ if .Description }}<meta name="description" content="{{ .Description }}">{{ end }}
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
</head>
<body class="bg-stone-900 text-white font-sans">

  <div class="flex justify-center">

    <div class="hidden md:block md:w-64 border-gray-800 overflow-y-auto mt-10">
      {{ template "navigation" }}
    </div>

    <div class="w-full md:max-w-2xl mx-8 my-10 flex-1 overflow-y-auto">
      <a href="/blog" class="text-sm text-gray-400 hover:text-white">&larr; All posts</a>

      <header class="mt-4 mb-8">
        <h1 class="text-3xl font-bold">{{ .Title }}</h1>
        <p class="text-sm text-gray-400 mt-2">{{ .Date }}{{ if .Author }} · {{ .Author }}{{ end }}</p>
      </header>

      <article class="prose prose-invert max-w-none">
        {{ .Content }}
      </article>
    </div>

  </div>
</body>
</html>
