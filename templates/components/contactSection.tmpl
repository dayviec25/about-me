{{ define "contact" }}
<section id="contacts" class="scroll-mt-24">
  <div class="rounded-2xl border border-line bg-accent-soft p-8 md:p-10">
    <div class="flex items-center gap-4">
      <img class="h-16 w-16 rounded-full object-cover" src="{{ .ProfilePictureURL }}" alt="{{ .Name }}">
      <div>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Let's build something.</h2>
        <p class="mt-1 text-muted">Open to senior mobile and AI product work. Always happy to talk shop.</p>
      </div>
    </div>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      {{ if .CallToActionLink }}<a href="{{ .CallToActionLink }}" target="_blank" rel="noopener" class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:bg-accent/90">Book a call</a>{{ end }}
      <a href="{{ .EmailLink }}" class="font-mono text-[11px] uppercase tracking-wider text-muted transition-colors hover:text-ink">Email</a>
      <a href="{{ .GithubLink }}" class="font-mono text-[11px] uppercase tracking-wider text-muted transition-colors hover:text-ink">GitHub</a>
      <a href="{{ .LinkedInLink }}" class="font-mono text-[11px] uppercase tracking-wider text-muted transition-colors hover:text-ink">LinkedIn</a>
      <a href="{{ .TwitterLink }}" class="font-mono text-[11px] uppercase tracking-wider text-muted transition-colors hover:text-ink">Twitter</a>
    </div>
  </div>
</section>
{{ end }}
