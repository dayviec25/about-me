{{ define "work" }}
<section id="experience" class="scroll-mt-24">
  <h2 class="border-b border-line pb-3 font-display text-2xl font-semibold tracking-tight">Experience</h2>
  <div class="divide-y divide-line">
    {{ range .WorkExperience }}
    <div class="grid grid-cols-1 gap-2 py-6 sm:grid-cols-[8rem_1fr] sm:gap-6">
      <div class="pt-1 font-mono text-[11px] uppercase tracking-wider text-muted">{{ .Date }}</div>
      <div>
        <div class="font-display text-lg font-semibold">{{ .Company }}</div>
        <div class="text-sm font-medium text-accent">{{ .Role }}</div>
        <p class="mt-2 text-sm leading-relaxed text-muted">{{ .Description }}</p>
      </div>
    </div>
    {{ end }}
  </div>
</section>
{{ end }}
