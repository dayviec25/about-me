{{ define "reviews" }}
<section id="reviews" class="scroll-mt-24">
  <h2 class="border-b border-line pb-3 font-display text-2xl font-semibold tracking-tight">What people say</h2>
  <div id="review-container" class="mt-6 rounded-2xl border border-line bg-surface p-7 md:p-9"
       hx-get="/review/initial" hx-trigger="load" hx-swap="innerHTML" hx-target="this">
  </div>
</section>
{{ end }}
