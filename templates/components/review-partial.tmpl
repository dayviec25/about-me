<figure>
  <blockquote class="text-lg md:text-xl leading-relaxed text-ink">
    <span class="font-display text-accent">&ldquo;</span>{{ .Review.Quote }}<span class="font-display text-accent">&rdquo;</span>
  </blockquote>
  <figcaption class="mt-6 flex items-end justify-between gap-4">
    <div>
      <div class="font-semibold">{{ .Review.Author }}</div>
      <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wider text-muted">{{ .Review.Company }}</div>
    </div>
    <div class="flex shrink-0 gap-2">
      <button hx-get="/review/{{ .PrevID }}/prev" hx-target="#review-container" hx-swap="innerHTML" aria-label="Previous review"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition hover:border-ink hover:text-ink {{ if .IsFirstReview}}invisible{{end}}">&larr;</button>
      <button hx-get="/review/{{ .NextID }}/next" hx-target="#review-container" hx-swap="innerHTML" aria-label="Next review"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition hover:border-ink hover:text-ink {{ if .IsLastReview }}invisible{{end}}">&rarr;</button>
    </div>
  </figcaption>
</figure>
