{{ define "about" }}
<section id="about" class="scroll-mt-24">
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{{ .Title }}</p>
  <h1 class="mt-5 font-display text-4xl md:text-5xl font-semibold leading-[1.05] tracking-tight">
    I build mobile apps<br class="hidden sm:block"> people use every day.
  </h1>
  <p class="mt-6 max-w-xl text-base md:text-lg leading-relaxed text-muted">{{ .Description }}</p>
  <div class="mt-8 flex flex-wrap gap-2.5 font-mono text-xs">
    <span class="inline-flex items-center rounded-full border border-line bg-surface px-3 py-1.5">8+ yrs shipping</span>
    <span class="inline-flex items-center rounded-full border border-line bg-surface px-3 py-1.5">Android &middot; Kotlin</span>
    <span class="inline-flex items-center rounded-full border border-line bg-surface px-3 py-1.5">100M+ installs</span>
  </div>
</section>
{{ end }}
