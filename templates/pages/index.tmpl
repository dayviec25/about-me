<!-- templates/pages/index.tmpl -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>David Chung — Senior Mobile Engineer</title>
  <meta name="description" content="David Chung — senior mobile engineer shipping Android apps used by millions, at Lyft and beyond.">
  {{ template "head-assets" }}
  <script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>
</head>
<body class="bg-canvas text-ink font-body antialiased">

  <div class="mx-auto w-full max-w-5xl px-5 md:px-8">
    <div class="md:flex md:gap-14">

      <aside class="md:w-56 md:shrink-0 md:self-start md:sticky md:top-0">
        {{ template "navigation" }}
      </aside>

      <main class="min-w-0 flex-1 py-12 md:py-24 space-y-20 md:space-y-28">
        {{ template "about" . }}
        {{ template "production" . }}
        {{ template "work" . }}
        {{ template "reviews" . }}
        {{ template "contact" .Contact }}
      </main>

    </div>
  </div>

</body>
</html>
